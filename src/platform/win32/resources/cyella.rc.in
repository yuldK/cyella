#include <windows.h>

#include "@CYELLA_RESOURCE_IDS_PATH@"

1 24 "@CYELLA_MANIFEST_PATH@"
IDI_CYELLA ICON "@CYELLA_APP_ICON_PATH@"
IDR_CYELLA_SYMBOL RCDATA "@CYELLA_SYMBOL_PATH@"
IDR_CYELLA_TITLE RCDATA "@CYELLA_TITLE_PATH@"
IDR_CYELLA_TITLE_SEA RCDATA "@CYELLA_TITLE_SEA_PATH@"
IDR_LOCALE_KO RCDATA "@CYELLA_LOCALE_KO_PATH@"
IDR_LOCALE_EN RCDATA "@CYELLA_LOCALE_EN_PATH@"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204B0"
        BEGIN
            VALUE "CompanyName", "Cyella contributors\0"
            VALUE "FileDescription", "Cyella\0"
            VALUE "FileVersion", "0.1.0\0"
            VALUE "InternalName", "cyella\0"
            VALUE "OriginalFilename", "cyella.exe\0"
            VALUE "ProductName", "Cyella\0"
            VALUE "ProductVersion", "0.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0412, 1200
    END
END
