{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 2,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-common",
            "hidden": true,
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/bin",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/bin",
                "CMAKE_SYSTEM_VERSION": "10.0.22621.0",
                "CYELLA_BUILD_TESTS": "OFF",
                "CYELLA_ENABLE_MSVC_ANALYZE": "OFF"
            }
        },
        {
            "name": "vs2022",
            "displayName": "Visual Studio 2022 x64",
            "inherits": "windows-common",
            "generator": "Visual Studio 17 2022"
        },
        {
            "name": "vs2026",
            "displayName": "Visual Studio 2026 x64",
            "inherits": "windows-common",
            "generator": "Visual Studio 18 2026"
        },
        {
            "name": "vs2022-tests",
            "displayName": "Visual Studio 2022 x64 with tests",
            "inherits": "vs2022",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CYELLA_BUILD_TESTS": "ON",
                "CYELLA_BUILD_TOOLING": "ON"
            }
        },
        {
            "name": "vs2026-tests",
            "displayName": "Visual Studio 2026 x64 with tests",
            "inherits": "vs2026",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CYELLA_BUILD_TESTS": "ON",
                "CYELLA_BUILD_TOOLING": "ON"
            }
        },
        {
            "name": "vs2022-analysis",
            "displayName": "Visual Studio 2022 x64 with MSVC analysis",
            "inherits": "vs2022",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CYELLA_ENABLE_MSVC_ANALYZE": "ON"
            }
        },
        {
            "name": "vs2026-analysis",
            "displayName": "Visual Studio 2026 x64 with MSVC analysis",
            "inherits": "vs2026",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CYELLA_ENABLE_MSVC_ANALYZE": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "vs2022-debug",
            "configurePreset": "vs2022",
            "configuration": "Debug"
        },
        {
            "name": "vs2022-release",
            "configurePreset": "vs2022",
            "configuration": "Release"
        },
        {
            "name": "vs2022-analysis",
            "configurePreset": "vs2022-analysis",
            "configuration": "Debug"
        },
        {
            "name": "vs2026-debug",
            "configurePreset": "vs2026",
            "configuration": "Debug"
        },
        {
            "name": "vs2026-release",
            "configurePreset": "vs2026",
            "configuration": "Release"
        },
        {
            "name": "vs2026-analysis",
            "configurePreset": "vs2026-analysis",
            "configuration": "Debug"
        },
        {
            "name": "vs2022-tests-debug",
            "configurePreset": "vs2022-tests",
            "configuration": "Debug"
        },
        {
            "name": "vs2022-tests-release",
            "configurePreset": "vs2022-tests",
            "configuration": "Release"
        },
        {
            "name": "vs2026-tests-debug",
            "configurePreset": "vs2026-tests",
            "configuration": "Debug"
        },
        {
            "name": "vs2026-tests-release",
            "configurePreset": "vs2026-tests",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "vs2022-tests-debug",
            "configurePreset": "vs2022-tests",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "vs2022-tests-release",
            "configurePreset": "vs2022-tests",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "vs2026-tests-debug",
            "configurePreset": "vs2026-tests",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "vs2026-tests-release",
            "configurePreset": "vs2026-tests",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        }
    ]
}
