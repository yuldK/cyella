# luil이 싣는 Codicons의 이름표(mapping.json)에서 이름 → 글리프 표를 만든다. 설정에 적는 아이콘 이름(`github`,
# `link-external`)을 글리프로 바꾸는 `presentation/codicon_names.cpp`가 include한다. 이름순으로 적어 이분 탐색한다.
function(cyella_generate_codicon_names input_file output_file)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input_file}")
    file(READ "${input_file}" mapping_json)
    string(JSON codepoint_count LENGTH "${mapping_json}")
    if(codepoint_count EQUAL 0)
        message(FATAL_ERROR "Codicons mapping is empty: ${input_file}")
    endif()
    math(EXPR last_codepoint_index "${codepoint_count} - 1")
    set(entries)
    foreach(codepoint_index RANGE 0 ${last_codepoint_index})
        string(JSON codepoint MEMBER "${mapping_json}" ${codepoint_index})
        string(JSON alias_count LENGTH "${mapping_json}" "${codepoint}")
        math(EXPR last_alias_index "${alias_count} - 1")
        math(EXPR codepoint_hex "${codepoint}" OUTPUT_FORMAT HEXADECIMAL)
        foreach(alias_index RANGE 0 ${last_alias_index})
            string(JSON alias GET "${mapping_json}" "${codepoint}" ${alias_index})
            string(TOLOWER "${alias}" alias)
            list(APPEND entries "${alias} ${codepoint_hex}")
        endforeach()
    endforeach()
    # 이름과 글리프를 공백으로 잇는다. 공백은 이름의 어느 글자보다 작아 "github"가 "github-action"보다 앞에 선다 (이분 탐색의 순서).
    list(SORT entries COMPARE STRING)
    set(output_text "// generated from ${input_file}\n")
    foreach(entry IN LISTS entries)
        string(REPLACE " " ";" parts "${entry}")
        list(GET parts 0 name)
        list(GET parts 1 code)
        string(APPEND output_text "{ \"${name}\", static_cast<char32_t>(${code}) },\n")
    endforeach()
    # 내용이 같으면 쓰지 않아 다시 컴파일하지 않는다.
    file(CONFIGURE OUTPUT "${output_file}" CONTENT "${output_text}" @ONLY)
endfunction()
